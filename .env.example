# Pin an exact production version. Review the upgrade path before changing it.
GITLAB_VERSION=19.2.1-ce.0
GITLAB_DOMAIN=git.example.com

# Nginx on the host: use 127.0.0.1.
# K3s EndpointSlice: use the host's private address, for example 10.0.0.10.
GITLAB_HTTP_BIND=127.0.0.1
GITLAB_HTTP_PORT=8080

# GitLab Shell must be reachable by Git clients.
GITLAB_SSH_BIND=0.0.0.0
GITLAB_SSH_PORT=2222
